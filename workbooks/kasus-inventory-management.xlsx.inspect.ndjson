{"kind":"table","sheet":"Jawaban","address":"A1:D22","rows":22,"cols":4,"values":[["Inventory Management",null,null,null],["inventory-management",null,null,null],[null,null,null,null],["Hasil kontrol studi kasus","Isi sel kuning",null,null],["Total nilai stok (IDR)",null,null,null],["Jumlah SKU di bawah minimum",null,null,null],["Harga P-003 (IDR)",null,null,null],[null,null,null,null],["Petunjuk",null,null,null],["Toko kantor ingin mengetahui modal dalam stok dan produk yang perlu dibeli. Kondisi restock didefinisikan Stok < Batas Minimum; nilai sama dengan batas belum masuk restock.",null,null,"Area laporan"],["Buat kolom Nilai Stok = Harga × Stok dan status restock pada area kerja/sheet baru.",null,null,"Buat ringkasan di sini atau sheet baru."],["Isi B5 total nilai stok, B6 jumlah SKU di bawah batas, dan B7 harga P-003.",null,null,null],["Sediakan input SKU dan hasil lookup. Tambahkan data validation pada input sesuai daftar SKU.",null,null,null],["Angka kontrol diperiksa otomatis. Grafik, PivotTable, query, dan layout dinilai memakai rubrik.",null,null,null],[null,null,null,null],[null,null,null,null],[null,null,null,null],["Rubrik tinjauan mandiri",null,null,null],["Total nilai stok cocok dengan penjumlahan nilai per produk.",null,null,null],["Aturan < diuji pada stok tepat di batas minimum.",null,null,null],["Dropdown SKU benar-benar membatasi input dan dapat dipakai.",null,null,null],["SKU tidak ditemukan menghasilkan pesan, bukan angka nol yang menyesatkan.",null,null,null]]}
