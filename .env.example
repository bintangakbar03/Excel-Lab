# Jangan commit file .env asli.
FLASK_SECRET_KEY=ganti-dengan-random-secret-panjang
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# Sign in with ChatGPT (aktif setelah OpenAI memberi OAuth client untuk website Anda)
OPENAI_CLIENT_ID=oaiapp_...
